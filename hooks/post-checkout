#!/usr/bin/env bash
# Automatically symlink shared worktree files into the current worktree on checkout.

# Only act on branch checkouts, not file checkouts
[[ "$3" == "1" ]] || exit 0

hooks_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

# The redirects force non-interactive mode and silence progress chatter;
# conflict notices still reach the user on stderr.
"$hooks_dir/../bin/wt-share" --current </dev/null >/dev/null
